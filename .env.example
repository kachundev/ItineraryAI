# Browser-safe Supabase values. Copy to .env.local for `npm run dev`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# XAI_API_KEY is NOT a Vite variable. Set it only as a Supabase Edge Function
# secret (or in a gitignored supabase/.env when serving functions locally):
#   supabase secrets set XAI_API_KEY=your_key
# Optional override (defaults to grok-4.7):
#   supabase secrets set XAI_MODEL=grok-4.7
